# GEMINI_API_KEY: Not used by HearthFrame (this app makes zero AI API calls).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# Optional fixed household login credentials (leave blank to use first-run setup UI)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
VISITOR_USERNAME="family"
VISITOR_PASSWORD=""

# Optional 32+ character random secret for signed media URLs (auto-generated if blank)
SESSION_SECRET=""

# Optional Cloudflare R2 storage for persistent photos, profiles & settings ($0 egress)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Optional multi-user signup controls (leave SIGNUP_INVITE_CODE blank for open signup)
SIGNUP_INVITE_CODE=""
MAX_ACCOUNTS="20"
